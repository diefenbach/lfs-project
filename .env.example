# Copy to .env and adjust. The settings read it; variables set in the real environment win over it.

# Development: debug pages, e-mails on the console, no secret key needed.
DJANGO_DEBUG=true

# Production: set DJANGO_DEBUG=false, a long random secret key, and your domain.
# Generate a key: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=shop.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# DJANGO_BEHIND_PROXY=true

# DJANGO_LANGUAGE_CODE=de
# DJANGO_TIME_ZONE=Europe/Berlin
# LFS_CURRENCY=EUR

# PostgreSQL instead of SQLite (install with: uv sync --extra postgres)
# POSTGRES_DB=shop
# POSTGRES_USER=shop
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# E-mail via SMTP (always used when DJANGO_DEBUG is false)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=shop@example.com

# PayPal (uv sync --extra paypal, and add "lfs_paypal" to INSTALLED_APPS; sandbox until PAYPAL_MODE=live)
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# Google Tag Manager (uv sync --extra gtm, and add "lfs_cookie_consent" and "lfs_gtm" to INSTALLED_APPS)
# GTM_ID=GTM-XXXXXXX

# Stripe (uv sync --extra stripe, and add "lfs_stripe" to INSTALLED_APPS)
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_SHOP_NAME=
